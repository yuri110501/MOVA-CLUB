# ==============================================================================
# MOVA Club Orlando — variáveis de ambiente para a Vercel
# Copie este arquivo para `.env.local` em desenvolvimento, ou cadastre as
# variáveis em Project Settings -> Environment Variables na Vercel.
# ==============================================================================

# 1. URL pública do site (sem barra no final). Para múltiplos domínios, separe por vírgula.
MOVA_PUBLIC_ORIGIN=https://www.movacluborlando.com

# 2. E-mail da conta Google que receberá o acesso inicial de Administradora principal
# (protegida contra revogação pelo painel).
MOVA_BOOTSTRAP_OWNER_EMAIL=seu-email@gmail.com

# 3. Auth.js / Login com Google (Google Cloud Console -> APIs & Services -> Credentials)
# Redirect URI autorizada no Google: https://www.movacluborlando.com/api/auth/callback/google
# Gere o segredo com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 4. Banco de dados Turso / libSQL (https://turso.tech ou integração Turso na Vercel)
# Em desenvolvimento local, se ficar vazio, usa automaticamente `.data/mova.db` (SQLite local).
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# 5. Vercel Blob para fotos enviadas pelo painel (Storage -> Create -> Blob na Vercel)
# Em desenvolvimento local, se ficar vazio, salva em `.data/uploads/`.
BLOB_READ_WRITE_TOKEN=

# Applies the reviewed bilingual event copy once; set 0 to defer it.
MOVA_ENABLE_CLIENT_COPY=1
